<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <permission android:name="com.ajadi.keys.permission.LOCAL_ENGINE" android:protectionLevel="signature"/>
    <uses-permission android:name="com.ajadi.keys.permission.LOCAL_ENGINE"/>
    <queries><package android:name="com.ajadi.keys.translation"/><package android:name="com.ajadi.keys.voice"/><package android:name="com.ajadi.keys.ai"/><package android:name="com.ajadi.keys.language.ru"/><package android:name="com.ajadi.keys.language.en"/><package android:name="com.ajadi.keys.language.he"/></queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:theme="@style/AppTheme"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider android:name=".EngineModelProvider" android:authorities="com.ajadi.keys.models" android:exported="true"
            android:readPermission="com.ajadi.keys.permission.LOCAL_ENGINE" android:writePermission="com.ajadi.keys.permission.LOCAL_ENGINE" android:grantUriPermissions="false"/>
        <service android:name=".AjadiImeService" android:exported="true"
            android:label="@string/app_name" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method"/>
        </service>
    </application>
</manifest>
